[Script]
黄果短剧 = type=http-response, pattern=^https?://huangguoai\.com, requires-body=1, max-size=-1, timeout=30, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/huangguoduanju/dist/huangguo.js

[Rule]
URL-REGEX,^https?://[^/]*adsdk[12]\.cc,REJECT

[MITM]
hostname = %APPEND% huangguoai.com, *.huangguoai.com
