[Script]
http-response ^https?://huangguoai\.com script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/huangguoduanju/dist/huangguo.js, requires-body=true, timeout=30, tag=黄果短剧

[Rule]
URL-REGEX,^https?://[^/]*adsdk[12]\.cc,REJECT

[MITM]
hostname = huangguoai.com, *.huangguoai.com
