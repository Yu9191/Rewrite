[Script]
huangdouduanju = type=http-response, pattern="^https?:\/\/cocoaview\.cc\/api\/(system\/info|user\/(info|home|vip|favorite)|drama\/(play|detail|navBlock|navFilter|searchResult|more|rank|topicDetail|topicList|favorite|love)|movie\/(navBlock|navFilter|detail|favorite|love|history))", requires-body=1, max-size=-1, timeout=30, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/huangdouduanju/dist/huangdou.js, argument=logLevel={{{日志级别}}}

[MITM]
hostname = %APPEND% cocoaview.cc, *.cocoaview.cc
