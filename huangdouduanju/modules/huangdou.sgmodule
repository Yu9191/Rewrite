#!name=黄豆短剧VIP解锁
#!desc=VIP解锁 + 去广告 + 完整播放（浏览器直接观看）
#!author=Yu9191 Rewrite
#!homepage=https://github.com/Yu9191/Rewrite
#!category=18+
#!date=2026-09-01
#!arguments=日志级别:info
#!arguments-desc=日志级别: off / error / warn / info(默认) / debug / all

[Script]
黄豆短剧请求 = type=http-request, pattern="^https?:\/\/(cocoaview\.cc|hdmgdj\.com|sxqirtho\.top|qicuknlj\.top|ferncider\.cc|hvthtcpa\.top|onyxripple\.cc|vivifable\.top|kucvcxrv\.cc|larkgarden\.top|niniharbor\.top|larksummit\.icu|lzlukvca\.cc)\/api\/(drama\/play|up\/episodePreview|up\/unlock|up\/access|up\/subscribe)", requires-body=1, binary-body-mode=1, max-size=-1, timeout=30, script-path=http://192.168.1.4:8888/dist/huangdou.js, argument=logLevel={{{日志级别}}}
黄豆短剧 = type=http-response, pattern="^https?:\/\/(cocoaview\.cc|hdmgdj\.com|sxqirtho\.top|qicuknlj\.top|ferncider\.cc|hvthtcpa\.top|onyxripple\.cc|vivifable\.top|kucvcxrv\.cc|larkgarden\.top|niniharbor\.top|larksummit\.icu|lzlukvca\.cc)\/api\/.+", requires-body=1, binary-body-mode=1, max-size=-1, timeout=30, script-path=http://192.168.1.4:8888/dist/huangdou.js, argument=logLevel={{{日志级别}}}

[MITM]
hostname = %APPEND% cocoaview.cc, *.cocoaview.cc, hdmgdj.com, *.hdmgdj.com, sxqirtho.top, *.sxqirtho.top, qicuknlj.top, *.qicuknlj.top, ferncider.cc, *.ferncider.cc, hvthtcpa.top, *.hvthtcpa.top, onyxripple.cc, *.onyxripple.cc, vivifable.top, *.vivifable.top, kucvcxrv.cc, *.kucvcxrv.cc, larkgarden.top, *.larkgarden.top, niniharbor.top, *.niniharbor.top, larksummit.icu, *.larksummit.icu, lzlukvca.cc, *.lzlukvca.cc
